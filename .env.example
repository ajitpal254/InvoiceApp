# Environment Mode (production / development)
NODE_ENV=production

# Server Port (assigned automatically by cloud hosts or defaults to 5000)
PORT=5000

# Host binding (0.0.0.0 for cloud deployments / Docker, 127.0.0.1 for local)
HOST=0.0.0.0

# MongoDB Connection URI (Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ShopmeApp?retryWrites=true&w=majority

# JWT Secret for Session Authentication
JWT_SECRET=your_production_secret_key_minimum_32_characters

# CORS_ORIGIN: comma-separated list of allowed origins. 
# Use * only for local development. Set your actual domain in production.
# Example: CORS_ORIGIN=https://yourdomain.com
CORS_ORIGIN=*
